# Buzzalicious web client — environment.
#
# Vite inlines import.meta.env at BUILD time. On Heroku the SPA is compiled during the
# slug build, before any dyno exists, so a runtime config var cannot reach this bundle.
# That is why VITE_API_URL is normally left unset in production: the client falls back
# to window.location.origin, which is correct for a single deployable.
# See docs/reference/platform-quirks.md.
#
# NEVER put a secret in a VITE_ variable. Everything here is shipped to the browser in
# plain text.

# Optional. Only needed when the API is on a different origin than the page and that
# origin is not the local development default (http://127.0.0.1:3001).
VITE_API_URL=
