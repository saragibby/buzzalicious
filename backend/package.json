{
  "name": "backend",
  "version": "1.0.0",
  "description": "Buzzalicious API and worker",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "dev:worker": "nodemon --watch src --ext ts --exec ts-node src/worker.ts",
    "build": "prisma generate && rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "postinstall": "prisma generate",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "fonts:vendor": "ts-node scripts/vendor-fonts.ts",
    "emoji:vendor": "ts-node scripts/vendor-emoji.ts",
    "render:sample": "ts-node scripts/render-sample.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.7.1",
    "@resvg/resvg-js": "^2.6.2",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.17.3",
    "multer": "^2.4.0",
    "openai": "^4.24.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "twitter-api-v2": "^1.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.10.6",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/pg": "^8.11.10",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.7.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
