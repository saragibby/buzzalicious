// Buzzalicious — v1 domain model.
//
// The contract is docs/02-data-model.md, with the full PlatformCredential definition from
// docs/10-credentials-and-security.md folded in. This file was authored by W2 and is
// edited by exactly one workstream at a time; W10 holds that ownership for the usage
// metering migration (ADR-0011). Every other workstream codes against what is here.
//
// Tenancy (ADR-0010): each client is a Workspace. Brand, SocialAccount,
// PlatformCredential, Asset, Post, PostTarget, Rendition, ShortLink, LinkClick,
// PostMetric and AiGeneration are workspace-owned and reachable from a workspaceId or a
// brandId. BusinessCategory, Trend, TrendSignal, TrendCategoryScore and
// TemplateCategoryTag are platform-global and carry no tenant column. Template is global
// by default with a nullable workspaceId reserved for client-specific templates.
//
// Conventions: UUID primary keys, snake_case tables via @@map, UTC DateTime throughout,
// JSON columns validated by exported Zod schemas colocated with the owning module.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & tenancy ──────────────────────────────────────────────────────────

model User {
  id          String           @id @default(uuid())
  email       String           @unique
  name        String?
  googleId    String?          @unique
  picture     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships Membership[]
  handshakes  OAuthHandshake[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Monthly AI provider-cost ceiling in USD (ADR-0011). Null means "use the configured
  /// platform default" rather than "unlimited" — an unset column must not be the way a
  /// workspace escapes the fuse. Decimal because it is money.
  aiMonthlyCeilingUsd Decimal? @db.Decimal(10, 2)

  memberships  Membership[]
  brands       Brand[]
  credentials  PlatformCredential[]
  // Client-specific templates. Empty in v1; every seeded template is global.
  templates    Template[]
  usageEvents  UsageEvent[]
  usageRollups UsagePeriodRollup[]

  @@map("workspaces")
}

model Membership {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  role        Role      @default(OWNER)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
  @@map("memberships")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

// ─── Business category taxonomy (global) ─────────────────────────────────────────

model BusinessCategory {
  id       String             @id @default(uuid())
  slug     String             @unique
  name     String
  parentId String?
  parent   BusinessCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children BusinessCategory[] @relation("CategoryTree")

  // Cold-start priors: which template archetypes historically work for this category.
  // Seeded by hand, overwritten by aggregate data once the feedback loop has volume.
  // Shape: CategoryPriorsSchema in modules/brand/category.schemas.ts
  priors Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands       Brand[]
  templateTags TemplateCategoryTag[]
  trendScores  TrendCategoryScore[]

  @@index([parentId])
  @@map("business_categories")
}

// ─── Brand kit ───────────────────────────────────────────────────────────────────

model Brand {
  id          String            @id @default(uuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  website     String?
  categoryId  String?
  category    BusinessCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Visual identity. NoAction on the logo link deliberately: Brand -> Asset (BrandAssets)
  // already cascades, and a second referential action back the other way would form a
  // cycle Postgres refuses to create.
  logoAssetId String?
  logo        Asset?  @relation("BrandLogo", fields: [logoAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Shape: BrandPaletteSchema / BrandTypographySchema in modules/brand/brand.schemas.ts
  palette    Json
  typography Json

  // Shape: BrandVoiceGuideSchema / BrandGoalsSchema in modules/brand/brand.schemas.ts
  voiceGuide      Json
  goals           Json?
  targetPlatforms Platform[]

  // IANA zone, e.g. "America/New_York" — never a UTC offset, which changes twice a year.
  // Guessed from the browser at creation; always user-editable. See docs/06.
  timezone String @default("America/New_York")

  // Soft delete: a brand carries posts, metrics and credentials, so removal is
  // recoverable by default. Every read path filters `deletedAt: null`.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  socialAccounts SocialAccount[]
  assets         Asset[]              @relation("BrandAssets")
  personas       PersonaLayer[]
  posts          Post[]
  shortLinks     ShortLink[]
  credentials    PlatformCredential[]
  generations    AiGeneration[]
  usageEvents    UsageEvent[]
  handshakes     OAuthHandshake[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, deletedAt])
  @@map("brands")
}

// ─── Personas (P1, modeled in v1) ────────────────────────────────────────────────

model PersonaLayer {
  id          String  @id @default(uuid())
  brandId     String
  brand       Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  description String?

  // Tone deltas layered over Brand.voiceGuide.
  // Shape: PersonaModifiersSchema in modules/brand/persona.schemas.ts
  modifiers Json

  status    PersonaStatus @default(SUGGESTED)
  source    String        @default("ai")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  posts     Post[]

  @@index([brandId, status])
  @@map("persona_layers")
}

enum PersonaStatus {
  SUGGESTED
  APPROVED
  DISMISSED
}

// ─── Social accounts ─────────────────────────────────────────────────────────────

model SocialAccount {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform    Platform
  externalId  String
  handle      String?
  displayName String?
  avatarUrl   String?

  // Encrypted at rest by the Prisma extension in platform/prisma-encryption.ts.
  // Plaintext never reaches the database, and these fields cannot appear in a `where`.
  accessToken  String
  refreshToken String?
  tokenSecret  String?

  expiresAt DateTime?
  scopes    String[]

  // Which platform app minted this token. Only that app can refresh it.
  // null = minted by the Buzzalicious PLATFORM_APP.
  credentialId String?
  credential   PlatformCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // IG needs a linked FB Page; Threads needs its own token. Adapter-specific data here.
  // Shape: PlatformMetaSchema in modules/publish/credential.schemas.ts
  platformMeta Json?

  status          AccountStatus @default(ACTIVE)
  lastError       String?
  lastValidatedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  postTargets     PostTarget[]

  @@unique([brandId, platform, externalId])
  // Supports the proactive token-refresh sweep. Expiry is a leading cause of silent
  // publish failure, and the prototype only discovered it at post time.
  @@index([status, expiresAt])
  @@index([credentialId])
  @@map("social_accounts")
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  THREADS
  X
  LINKEDIN
  TIKTOK
  YOUTUBE
}

enum AccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

// ─── Platform credentials (docs/10, ADR-0009) ────────────────────────────────────

model PlatformCredential {
  id String @id @default(uuid())

  // Scope: brandId set = brand-specific; null = shared across the workspace.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandId     String?
  brand       Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  platform Platform
  mode     CredentialMode
  label    String

  // CLIENT_APP
  appId       String?
  appSecret   String? // encrypted
  redirectUri String?

  // DIRECT_TOKEN / Meta system user
  directToken       String? // encrypted
  directTokenSecret String? // encrypted; X OAuth 1.0a
  systemUserToken   String? // encrypted
  tokenExpiresAt    DateTime?

  // What the client's app is actually approved for, discovered at pre-flight.
  grantedScopes  String[]
  requiredScopes String[]
  // Shape: CredentialCapabilitiesSchema in modules/publish/credential.schemas.ts
  capabilities   Json?

  status          CredentialStatus @default(PENDING)
  lastValidatedAt DateTime?
  lastError       String?
  rotatedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  socialAccounts SocialAccount[]
  accessLogs     CredentialAccessLog[]
  handshakes     OAuthHandshake[]

  @@index([workspaceId, platform, status])
  @@index([status, tokenExpiresAt])
  @@index([brandId])
  @@map("platform_credentials")
}

enum CredentialMode {
  DIRECT_TOKEN
  CLIENT_APP
  PLATFORM_APP
}

enum CredentialStatus {
  PENDING
  ACTIVE
  INSUFFICIENT
  INVALID
  REVOKED
}

model CredentialAccessLog {
  id           String             @id @default(uuid())
  credentialId String
  credential   PlatformCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  occurredAt   DateTime           @default(now())
  actor        String
  action       String
  context      Json?

  @@index([credentialId, occurredAt])
  @@map("credential_access_logs")
}

/// Server-side state for an in-flight OAuth authorization (W6).
///
/// Exists because X's OAuth 1.0a callback returns `oauth_token` and `oauth_verifier` but
/// **not** `oauth_token_secret`, and leg 3 cannot be completed without the secret issued
/// in leg 1 (docs/reference/x-oauth1a.md). The prototype held that secret in an
/// in-process `Map`, which loses every in-flight handshake on a restart and misses
/// outright when Heroku routes the callback to a different dyno than served leg 1.
///
/// It is also where the signed `state` is anchored: the row carries the `credentialId`,
/// so the callback knows whose app secret to use for the exchange, and `nonce` binds the
/// redirect to the browser that started it. Single-use and TTL'd — an abandoned
/// authorization must expire rather than sit holding a secret indefinitely.
model OAuthHandshake {
  id           String             @id @default(uuid())
  credentialId String
  credential   PlatformCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  platform     Platform

  /// Which brand the resulting SocialAccount rows belong to.
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// Signed into `state` and compared on the way back. Unique so a replay of a consumed
  /// callback cannot start a second exchange.
  nonce String @unique

  /// OAuth 1.0a only. `requestToken` is the lookup key X returns on the callback;
  /// `requestTokenSecret` is encrypted at rest by platform/prisma-encryption.ts.
  requestToken       String? @unique
  requestTokenSecret String?

  initiatedByUserId String?
  initiatedBy       User?   @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([credentialId])
  @@index([expiresAt])
  @@map("oauth_handshakes")
}

// ─── Assets ──────────────────────────────────────────────────────────────────────

model Asset {
  id         String    @id @default(uuid())
  brandId    String
  brand      Brand     @relation("BrandAssets", fields: [brandId], references: [id], onDelete: Cascade)
  kind       AssetKind
  storageKey String
  mimeType   String
  width      Int?
  height     Int?
  bytes      Int
  checksum   String?
  source     String    @default("upload")
  altText    String?
  tags       String[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  brandLogos Brand[]   @relation("BrandLogo")

  @@index([brandId, kind])
  @@map("assets")
}

enum AssetKind {
  LOGO
  PHOTO
  VIDEO
  FONT
  RENDITION
}

// ─── Templates (global, ADR-0010) ────────────────────────────────────────────────

model Template {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  description String?
  archetype   String
  kind        TemplateKind @default(IMAGE)

  // null = platform-global, which every v1 template is. Reserved so that
  // client-specific templates are an additive change rather than a migration of
  // every existing row. See ADR-0010.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // What the user must supply: named, typed slots.
  // Shape: SlotSchemaSchema in modules/template/template.schemas.ts
  slotSchema Json

  // The renderable definition consumed by the Satori pipeline (docs/05).
  // Shape: TemplateLayoutSchema in modules/template/template.schemas.ts
  layout          Json
  supportedRatios AspectRatio[]

  // Performance is attributed to a template, so editing one in place would corrupt the
  // feedback loop. Post stores templateVersion; a breaking layout change bumps this.
  version   Int            @default(1)
  status    TemplateStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  categoryTags TemplateCategoryTag[]
  posts        Post[]

  @@index([status, archetype])
  @@index([workspaceId])
  @@map("templates")
}

model TemplateCategoryTag {
  templateId String
  categoryId String
  // Hand-assigned 0..1 relevance for v1; auto-scored once feedback data exists.
  weight     Float            @default(1.0)
  source     String           @default("manual")
  template   Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([templateId, categoryId])
  @@index([categoryId, weight])
  @@map("template_category_tags")
}

enum TemplateKind {
  IMAGE
  CAROUSEL
  TEXT_ONLY
  VIDEO
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AspectRatio {
  SQUARE_1_1
  PORTRAIT_4_5
  STORY_9_16
  LANDSCAPE_16_9
}

// ─── Trends (global, docs/07) ────────────────────────────────────────────────────

model Trend {
  id          String      @id @default(uuid())
  platform    Platform?
  kind        TrendKind
  externalRef String?
  title       String
  description String?
  exampleUrls String[]
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  peakedAt    DateTime?
  status      TrendStatus @default(EMERGING)
  velocity    Float?
  momentum    Float?
  // Shape: TrendRawSchema in modules/trend/trend.schemas.ts
  raw         Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  signals        TrendSignal[]
  categoryScores TrendCategoryScore[]
  posts          Post[]

  @@unique([platform, kind, externalRef])
  @@index([status, momentum])
  @@map("trends")
}

model TrendSignal {
  id          String   @id @default(uuid())
  trendId     String
  trend       Trend    @relation(fields: [trendId], references: [id], onDelete: Cascade)
  collectorId String
  observedAt  DateTime @default(now())
  // Shape: TrendSignalMetricsSchema in modules/trend/trend.schemas.ts
  metrics     Json

  @@index([trendId, observedAt])
  @@map("trend_signals")
}

model TrendCategoryScore {
  trendId    String
  categoryId String
  score      Float
  computedAt DateTime         @default(now())
  trend      Trend            @relation(fields: [trendId], references: [id], onDelete: Cascade)
  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([trendId, categoryId])
  @@index([categoryId, score])
  @@map("trend_category_scores")
}

enum TrendKind {
  HASHTAG
  SOUND
  FORMAT
  TOPIC
}

enum TrendStatus {
  EMERGING
  PEAKING
  DECLINING
  STALE
}

// ─── Posts & publishing ──────────────────────────────────────────────────────────

model Post {
  id      String @id @default(uuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  templateId      String?
  template        Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  templateVersion Int?
  trendId         String?
  trend           Trend?        @relation(fields: [trendId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  personaId       String?
  persona         PersonaLayer? @relation(fields: [personaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  title      String?
  // User-supplied values for Template.slotSchema.
  // Shape: SlotValuesSchema in modules/template/template.schemas.ts
  slotValues Json?
  baseCopy   String?    @db.Text
  status     PostStatus @default(DRAFT)

  // v1 ships IMAGE and TEXT. A TEXT post has zero renditions — the publish pipeline
  // must tolerate that, which is also what makes X and Threads text posts work.
  mediaType MediaType @default(IMAGE)

  // Scheduling stores the UTC instant AND the intent behind it. Without the local time
  // plus zone, "every Tuesday at 9am" silently drifts across DST. See docs/06.
  scheduledAt    DateTime?
  scheduledLocal String?
  scheduledTz    String?
  scheduleSource ScheduleSource @default(USER)
  // Learned-slot key, e.g. "weekday:midday". Eight buckets: day type x daypart.
  scheduleSlot   String?

  // A/B support (P1): variants share a variantGroupId.
  variantGroupId String?
  variantLabel   String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  targets     PostTarget[]
  renditions  Rendition[]
  shortLinks  ShortLink[]
  generations AiGeneration[]

  @@index([brandId, status, createdAt])
  @@index([brandId, deletedAt])
  @@index([brandId, scheduleSlot])
  @@index([variantGroupId])
  @@map("posts")
}

model PostTarget {
  id              String         @id @default(uuid())
  postId          String
  post            Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform        Platform
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  caption     String?    @db.Text
  renditionId String?
  rendition   Rendition? @relation(fields: [renditionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  scheduledFor   DateTime?
  status         TargetStatus       @default(DRAFT)
  externalPostId String?
  externalUrl    String?
  publishedAt    DateTime?
  attempts       Int                @default(0)
  lastError      String?
  /// Typed classification of `lastError` (docs/08). A free-text string cannot tell the
  /// UI whether the client should reconnect one account or fix one app secret, and those
  /// are different actions with very different blast radii.
  errorClass     PublishErrorClass?
  /// When the pipeline intends to try again. Set for a QUOTA deferral, where the rule is
  /// "reschedule past the window rather than failing", and for a backed-off retry — the
  /// user has to be able to see that a post is waiting rather than stuck.
  nextAttemptAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  metrics PostMetric[]
  usage   UsageEvent[]

  @@unique([postId, platform])
  @@index([status, scheduledFor])
  @@index([publishedAt])
  @@map("post_targets")
}

model Rendition {
  id           String       @id @default(uuid())
  postId       String
  post         Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaType    MediaType    @default(IMAGE)
  aspectRatio  AspectRatio
  storageKey   String
  mimeType     String       @default("image/png")
  width        Int
  height       Int
  durationMs   Int?
  bytes        Int
  renderedAt   DateTime     @default(now())
  // Shape: RendererMetaSchema in modules/render/rendition.schemas.ts
  rendererMeta Json?
  targets      PostTarget[]
  usage        UsageEvent[]

  @@index([postId, aspectRatio])
  @@map("renditions")
}

enum MediaType {
  IMAGE
  TEXT
  VIDEO
}

enum ScheduleSource {
  USER
  SUGGESTED
  EXPLORATION
}

enum PostStatus {
  DRAFT
  READY
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  ARCHIVED
}

enum TargetStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
  /// The credential or account this target needs is unusable, so the target was never
  /// attempted. Distinct from FAILED on purpose (docs/10): revoking a credential must
  /// halt scheduled posts visibly, and calling that a failure tells the client their
  /// content was rejected when in fact it is waiting for them to reconnect.
  BLOCKED
}

/// The error taxonomy from docs/08, as data.
///
/// CREDENTIAL is deliberately separate from AUTH: one is "this client's app secret is
/// wrong", which one action fixes for every account minted by it, and the other is "this
/// one account's token was revoked". Collapsing them makes the UI point at the wrong
/// thing, which is how the prototype's single `lastError` string behaved.
enum PublishErrorClass {
  TRANSIENT
  AUTH
  CREDENTIAL
  VALIDATION
  POLICY
  QUOTA
}

// ─── Outcomes: short links and metrics (docs/06) ─────────────────────────────────

model ShortLink {
  id             String      @id @default(uuid())
  slug           String      @unique
  brandId        String
  brand          Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  postId         String?
  post           Post?       @relation(fields: [postId], references: [id], onDelete: SetNull)
  platform       Platform?
  destinationUrl String
  createdAt      DateTime    @default(now())
  expiresAt      DateTime?
  clicks         LinkClick[]

  @@index([brandId, createdAt])
  @@index([postId])
  @@map("short_links")
}

model LinkClick {
  id          String    @id @default(uuid())
  shortLinkId String
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  occurredAt  DateTime  @default(now())
  // Salted hash, never the raw IP. See docs/06.
  ipHash      String?
  userAgent   String?
  referrer    String?
  country     String?
  deviceType  String?
  // Link-preview crawlers hit every short link on publish. Unfiltered they would poison
  // the outcome signal the whole feedback loop rests on.
  isBot       Boolean   @default(false)

  @@index([shortLinkId, occurredAt])
  @@index([shortLinkId, isBot, occurredAt])
  @@map("link_clicks")
}

// Time-series snapshots, not mutable totals. Platform counters move for days after
// publish; snapshots give velocity, like-for-like comparison at "24h after publish", and
// recovery from a bad ingest.
model PostMetric {
  id           String     @id @default(uuid())
  postTargetId String
  postTarget   PostTarget @relation(fields: [postTargetId], references: [id], onDelete: Cascade)
  capturedAt   DateTime   @default(now())
  source       String

  impressions   Int?
  reach         Int?
  likes         Int?
  comments      Int?
  shares        Int?
  saves         Int?
  videoViews    Int?
  profileVisits Int?
  // First-party, derived from LinkClick.
  linkClicks    Int?
  // Shape: PostMetricRawSchema in modules/insight/metric.schemas.ts
  raw           Json?

  @@unique([postTargetId, capturedAt])
  @@index([postTargetId, capturedAt])
  @@map("post_metrics")
}

// ─── AI telemetry ────────────────────────────────────────────────────────────────

model AiGeneration {
  id      String  @id @default(uuid())
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  postId  String?
  post    Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  purpose          String
  provider         String
  model            String?
  prompt           String   @db.Text
  response         String   @db.Text
  responseTimeMs   Int?
  promptTokens     Int?
  completionTokens Int?
  estimatedCost    Float?
  createdAt        DateTime @default(now())

  usage UsageEvent[]

  @@index([brandId, createdAt])
  @@index([postId])
  @@map("ai_generations")
}

// ─── Usage metering (ADR-0011) ───────────────────────────────────────────────────
//
// The meter is deliberately not AI-specific. AiGeneration above stays domain telemetry
// for debugging prompts; it has no workspace, no idempotency key, and a Float cost, which
// makes it the wrong shape for anything billable. Billing quantities live in UsageEvent
// and reference the telemetry row as the source record rather than acting as the counter.

enum UsageMetric {
  /// quantity = total tokens for one provider call; providerCostUsd = vendor charge.
  AI_TOKENS
  /// quantity = 1 per PostTarget actually delivered. Emitted by W6.
  POST_PUBLISHED
  /// quantity = 1 per Rendition produced.
  RENDITION_RENDERED
  /// quantity = 1 per collection or curation run over the global feed.
  TREND_REFRESH
  /// quantity = accounts newly connected.
  CONNECTED_ACCOUNT
}

/// Append-only. No updates, no deletes: a mutable billing ledger is not a ledger. A
/// wrongly recorded charge is corrected with a compensating event, not an UPDATE — which
/// is why there is no `updatedAt` here and why nothing in the codebase writes one.
model UsageEvent {
  id String @id @default(uuid())

  // Workspace is the client and therefore the billing entity (ADR-0010). Required.
  // Brand is optional: platform-global work (trend classification) has no brand, and a
  // hard-deleted brand must not take the ledger row with it — hence SetNull, not Cascade.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandId     String?
  brand       Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  metric   UsageMetric
  /// Integer, in the metric's own unit. Never money.
  quantity Int

  /// What the vendor charged *us*. Never what a customer is charged — keeping them apart
  /// is what keeps per-tier margin visible later. Decimal, never Float.
  providerCostUsd Decimal? @db.Decimal(12, 6)

  /// Caller-supplied natural key, and **attempt-independent**: `publish:{postTargetId}`,
  /// never `publish:{postTargetId}:{attempt}`. A post published after three retries is
  /// one billable post, so emitting is safe for a caller that cannot tell it is a retry.
  idempotencyKey String @unique

  occurredAt  DateTime @default(now())
  /// First instant of the UTC calendar month containing `occurredAt`. Stored rather than
  /// derived so the rollup key is an indexed column instead of an expression.
  periodStart DateTime

  // The thing that caused the charge. "Why is this invoice $340" has to be answerable,
  // and all three are SetNull so answering it never stands in the way of a delete.
  aiGenerationId String?
  aiGeneration   AiGeneration? @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  postTargetId   String?
  postTarget     PostTarget?   @relation(fields: [postTargetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  renditionId    String?
  rendition      Rendition?    @relation(fields: [renditionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Shape: UsageMetadataSchema in modules/usage/usage.schemas.ts
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([workspaceId, metric, periodStart])
  @@index([workspaceId, occurredAt])
  @@index([aiGenerationId])
  @@map("usage_events")
}

/// Derived from UsageEvent, and reconstructible from it at any time. It exists so a cap
/// check is one indexed read instead of an aggregate over the ledger — never as a second
/// source of truth. "Rebuild from events equals incremental totals" is a test.
model UsagePeriodRollup {
  id String @id @default(uuid())

  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metric      UsageMetric
  periodStart DateTime
  periodEnd   DateTime

  /// BigInt because token counts accumulate; the event column stays Int.
  quantity        BigInt  @default(0)
  providerCostUsd Decimal @default(0) @db.Decimal(14, 6)
  eventCount      Int     @default(0)

  updatedAt DateTime @updatedAt

  @@unique([workspaceId, metric, periodStart])
  @@index([workspaceId, periodStart])
  @@map("usage_period_rollups")
}
