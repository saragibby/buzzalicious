# Buzzalicious API — environment.
#
# Every variable here is validated at boot by src/platform/config.ts. A missing or
# malformed required value stops the process and prints exactly which ones are wrong;
# nothing falls back to a default that only looks right.
#
# NEVER commit real values. In a deployed environment these are Heroku config vars.
# Copy this file to backend/.env for local development.

# ── Core ────────────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# Heroku assigns PORT; do not set it there.
PORT=3001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────────────────
# Heroku Postgres sets this automatically.
DATABASE_URL=

# Optional. When set, tests that need a real database run; when unset they skip, so
# `npm test` passes on a clean clone. Must NOT point at a database you care about —
# the suite truncates it. See docs/12-testing.md.
TEST_DATABASE_URL=

# ── URLs ────────────────────────────────────────────────────────────────────────
# Absolute base URL of the API. No trailing slash.
#
# Use 127.0.0.1, not localhost. They are different cookie origins and different
# strings for OAuth redirect matching, and mixing them produces a session that looks
# like it works and then is not there. See docs/reference/platform-quirks.md.
APP_URL=http://127.0.0.1:3001

# Absolute base URL the SPA is served from. Post-login redirects go here.
# In production this is the same host as APP_URL — one deployable.
WEB_URL=http://127.0.0.1:5173

# ── Sessions ────────────────────────────────────────────────────────────────────
# At least 32 characters. Rotating it signs every existing user out.
#   openssl rand -base64 32
SESSION_SECRET=

# Optional. Defaults to 7 days.
SESSION_MAX_AGE_MS=

# ── Google sign-in ──────────────────────────────────────────────────────────────
# The authorised redirect URI in Google Cloud Console must be exactly
# ${APP_URL}/auth/google/callback — byte for byte.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional comma-separated allow lists. Both empty means anyone with a Google
# account may sign in.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Optional development seed user added as ADMIN to every sample client workspace.
# When unset, the seed uses an obviously fake test account.
SEED_ADMIN_EMAIL=

# ── Encryption ──────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts OAuth tokens and client app secrets at rest.
#   openssl rand -base64 32
#
# Losing this makes every stored credential permanently unreadable. Back it up
# somewhere that is not this application.
ENCRYPTION_KEY=

# Identifies the key that wrote a given ciphertext, so rotation can be incremental.
# Bump it when introducing a new key; keep the old key available to read old values.
ENCRYPTION_KEY_ID=k1

# ── Worker ──────────────────────────────────────────────────────────────────────
# Run job consumers in this process. Convenient locally; on Heroku the worker is its
# own dyno, so leave this false on web dynos.
WORKER_ENABLED=false

# ── Object storage ──────────────────────────────────────────────────────────────
# local | r2
#
# `local` is development only and is REJECTED in production: Heroku's filesystem is
# ephemeral, so anything written to it disappears on the next dyno restart.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Required when STORAGE_DRIVER=r2.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# ── AI providers ────────────────────────────────────────────────────────────────
# Our own platform keys, for our own features. These are NOT the client-supplied
# platform credentials from ADR-0009, which are per workspace and stored encrypted.
# The first configured provider is used by default.
OPENAI_API_KEY=
GEMINI_API_KEY=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# ── Publishing (W6) ─────────────────────────────────────────────────────────────
# ADR-0009: clients bring their own platform app credentials, stored encrypted in the
# database per workspace. The variables below are the LAST-RESORT third tier of the
# resolver — Buzzalicious' own app, used when a workspace has not supplied one. A
# client credential always wins over these, and no adapter ever reads env directly:
# every PlatformAdapter method takes a resolved credential.
#
# Leaving these unset is a supported configuration. It means a workspace must connect
# its own app before it can publish, which is the durable end state anyway.
PLATFORM_APP_X_KEY=
PLATFORM_APP_X_SECRET=

# Meta covers Facebook and Instagram, which share one app. Threads is a separate app
# even though it is also Meta — the API and the permission set are different.
PLATFORM_APP_META_ID=
PLATFORM_APP_META_SECRET=
PLATFORM_APP_THREADS_ID=
PLATFORM_APP_THREADS_SECRET=

# How long a user has to complete an OAuth handshake once they click Connect, in
# seconds. Defaults to 600. The matching OAuthHandshake row is single-use, so this is
# a ceiling on an abandoned flow rather than on a valid one.
OAUTH_HANDSHAKE_TTL_SECONDS=

# How many days before a stored token expires the refresh sweep starts trying.
# Defaults to 7. Long enough to survive a weekend plus a failed attempt.
TOKEN_REFRESH_LEAD_DAYS=

# How many times a single post target is attempted before it is marked FAILED.
# Defaults to 5. Attempts back off 1m, 2m, 4m… capped at an hour; a platform-supplied
# Retry-After always wins.
PUBLISH_MAX_ATTEMPTS=

# Legacy, and deliberately still here. These were the prototype's single hard-coded X
# app. Nothing reads them any more — PLATFORM_APP_X_KEY/SECRET replaced them — but the
# names are kept documented so that a deploy still carrying them is not mistaken for a
# working configuration.
TWITTER_API_KEY=
TWITTER_API_SECRET=

# ── Trend curation (W9) ─────────────────────────────────────────────────────────
# Comma-separated email allow-list for the weekly trend curation admin UI at
# /trends/curate and the /api/admin/trends routes behind it. There is no global
# staff flag in the schema yet, so this is the gate. Fail-closed: unset means
# nobody is an admin, and the curation API returns 404 to everyone.
TREND_ADMIN_EMAILS=

# ── Usage metering (W10) ────────────────────────────────────────────────────────
# Comma-separated email allow-list for the platform-wide usage view at /admin/usage
# and the /api/admin/usage route behind it. Deliberately separate from
# TREND_ADMIN_EMAILS: that one grants editorial curation, this one exposes every
# workspace's spend, and the two are not the same trust level. Fail-closed: unset
# means nobody is an admin and the route returns 404.
PLATFORM_ADMIN_EMAILS=

# Per-workspace monthly ceiling on AI provider spend, in USD. Defaults to 25.00 when
# unset; a workspace can override it via Workspace.aiMonthlyCeilingUsd.
#
# This is a SPEND FUSE, NOT A PRICE. It exists so a runaway loop or a bad prompt
# cannot quietly bill thousands of dollars overnight — it is not a plan limit, not a
# quota we sell, and not a number to show a customer as an entitlement. Pricing is
# undecided (docs/09-open-questions.md Q13) and this value must not be mistaken for
# it. When it blows, AI generation stops; already-scheduled posts still publish.
AI_MONTHLY_CEILING_USD=
